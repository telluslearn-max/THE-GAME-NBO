# --- required ---
PHX_HOST=order.example.com                 # your public hostname (also the M-Pesa callback host)
DB_PASSWORD=change-me
SECRET_KEY_BASE=                           # openssl rand -base64 64 | tr -d '\n'
MPESA_CALLBACK_TOKEN=                      # openssl rand -hex 24  (becomes part of the callback URL)

# --- M-Pesa (Daraja). Production refuses to boot without these unless MPESA_ADAPTER=fake ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_BASE_URL=https://sandbox.safaricom.co.ke   # switch to https://api.safaricom.co.ke only after sandbox sign-off
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline     # CustomerBuyGoodsOnline for a Till
# MPESA_PARTY_B=                                 # Till number, if different from the shortcode

# --- Web Push (optional): mix generate.vapid.keys ---
# WEBPUSH_VAPID_PUBLIC_KEY=
# WEBPUSH_VAPID_PRIVATE_KEY=
# WEBPUSH_VAPID_SUBJECT=mailto:you@example.com
