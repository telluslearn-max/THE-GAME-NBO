<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0b0b0a" />
    <meta name="color-scheme" content="dark" />
    <meta
      name="description"
      content="Order drinks at THE GAME from your phone, pay with M-Pesa, collect with a code."
    />
    <meta name="csrf-token" content={get_csrf_token()} />
    <title>{assigns[:page_title] || "THE GAME"}</title>
    <link rel="icon" href={~p"/favicon.svg"} type="image/svg+xml" />
    <link rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer src={~p"/assets/js/app.js"}>
    </script>
    <script
      :if={assigns[:page_js]}
      defer
      src={TheGameWeb.Endpoint.static_path("/assets/js/" <> assigns[:page_js] <> ".js")}
    >
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    {@inner_content}
  </body>
</html>
