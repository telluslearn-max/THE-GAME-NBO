<header class="wrap top">
  <a class="brand" href={~p"/"} aria-label="THE GAME, home"><TheGameWeb.Layouts.wordmark /></a>
  <nav aria-label="Primary"><a class="navlink" href={~p"/orders"}>Orders</a></nav>
</header>

<main id="main" class="wrap">
  <p class="status" role="status">{status_text(@order.status)}</p>

  <div class="ticket">
    <span class="ticket-k">Pickup code</span>
    <span class="ticket-code">{@order.pickup_code}</span>
    <span class="ticket-n">Show this at the bar</span>
  </div>

  <ul class="rows">
    <li :for={i <- @order.items} class="row">
      <div>
        <span class="name">{i.qty} × {i.name}</span>
        <span class="price">{TheGame.Catalog.money(i.qty * i.unit_price_cents)}</span>
      </div>
    </li>
  </ul>
  <div class="total">
    <span>Total</span><output class="mono">{TheGame.Catalog.money(@order.total_cents)}</output>
  </div>
</main>
