<header class="wrap top">
  <a class="brand" href={~p"/"} aria-label="THE GAME, home"><TheGameWeb.Layouts.wordmark /></a>
  <nav aria-label="Primary"><a class="navlink" href={~p"/orders"}>Orders</a></nav>
</header>

<main id="main" class="wrap">
  <a class="back" href={~p"/menu"}>← Menu</a>
  <h1 class="h1">Your order</h1>

  <p :if={@error} class="notice" role="alert">{@error}</p>
  <p :if={@paused && !@error} class="notice" role="status">
    Ordering is paused for a short stock count. Check back soon, and don’t pay at the till while it’s paused.
  </p>
  <p id="cart-msg" class="notice" role="status" hidden></p>

  <div id="cart-empty" class="empty" hidden>
    <b>Your cart is empty</b>
    <a class="btn ghost" href={~p"/menu"}>Browse the menu</a>
  </div>

  <form id="cart-form" method="post" action={~p"/orders"} hidden>
    <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
    <input type="hidden" name="items" id="f-items" />
    <input type="hidden" name="expected_total" id="f-total" />

    <ul id="lines" class="rows"></ul>

    <div class="total"><span>Total</span><output id="total" class="mono">KES 0</output></div>

    <div id="blocked" class="panel blocked" role="alert" hidden>
      <p class="p"><b>This number has an unpaid order.</b></p>
      <p class="help">
        Finish or cancel it first. <b>If you already paid, don’t pay again:</b>
        show your waiter your M-Pesa message.
      </p>
      <a id="blocked-open" class="btn ghost" href="#" hidden>Open my unpaid order</a>
      <button id="blocked-recheck" type="button" class="linkbtn">Check again</button>
    </div>

    <label class="field" for="phone">M-Pesa number that will pay</label>
    <input
      id="phone"
      name="phone"
      type="tel"
      inputmode="tel"
      autocomplete="tel-national"
      placeholder="0712 345 678"
      value={@phone}
      required
      pattern="^\s*(0|\+?254)?[17][0-9 \-]{8,12}\s*$"
      aria-describedby="phone-help"
    />
    <p id="phone-help" class="help">
      Enter the number you will pay from. You’ll then see how to pay. Your drinks are held for 30 minutes.
    </p>

    <button id="pay" class="btn" type="submit" disabled={@paused}>Place order</button>
  </form>
</main>
