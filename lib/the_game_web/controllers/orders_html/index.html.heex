<header class="wrap top">
  <a class="brand" href={~p"/"} aria-label="THE GAME, home"><TheGameWeb.Layouts.wordmark /></a>
  <nav aria-label="Primary"><a class="navlink" href={~p"/"}>Menu</a></nav>
</header>

<main id="main" class="wrap">
  <h1 class="h1">Your orders</h1>

  <div :if={@orders == []} class="empty">
    <b>No orders on this phone yet</b>
    Orders you place here show up in this list.
    <div><a class="btn ghost" href={~p"/"}>Browse the menu</a></div>
  </div>

  <ul class="rows">
    <li :for={o <- @orders} class="row">
      <a class="olink" href={~p"/order/#{o.id}"}>
        <span class="name">
          <span class="mono">{o.pickup_code}</span>
          <% {text, kind} = status_tag(o.status) %>
          <span class={["tag", kind]}>{text}</span>
        </span>
        <span class="price">{summary(o)}</span>
        <span class="price">
          {TheGame.Catalog.money(o.total_cents)} · {when_eat(o.inserted_at)}
        </span>
      </a>
    </li>
  </ul>
</main>
